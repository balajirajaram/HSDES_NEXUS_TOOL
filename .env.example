# ---- HSDES REST API ----
# Base URL of the Intel HSDES REST endpoint (adjust to your environment).
HSDES_BASE_URL=https://hsdes-api.intel.com/rest

# Auth mode:
#   auto   -> Kerberos SSO using the logged-in Intel user (NO prompt) [recommended]
#             requires: pip install requests requests-kerberos
#   basic  -> users sign in with Intel username + password (prompted at launch)
#   token  -> a personal API token (set HSDES_API_TOKEN)
HSDES_AUTH_MODE=auto
HSDES_API_TOKEN=

# Signs the session cookie (holds only a random session id, never credentials).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- LLM (OpenAI-compatible chat endpoint) ----
# e.g. an Azure OpenAI or Intel-internal OpenAI-compatible gateway.
# Leave blank to run in OFFLINE (deterministic, no-LLM) mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ---- Learned Knowledge Base ----
KB_DB_PATH=kb/hsd_kb.sqlite

# ---- Optional MCP enrichment (Geni HSDES + Co-Design HSDES agents) ----
# When set, each analysis ALSO queries these internal MCP gateways and folds their
# answers into the ticket context, so the report is grounded in HSDES REST + Geni +
# Co-Design together. Leave blank to disable (default). Each source is independent;
# a per-user bearer token is required. Protocol = MCP Streamable HTTP (JSON-RPC).
MCP_PROTOCOL_VERSION=2025-06-18
# Geni HSDES / Axon / HSD-index agent gateway:
GENI_MCP_URL=
GENI_MCP_TOOL=HSDTool
GENI_MCP_TOKEN=
# Co-Design HSDES agent gateway:
CODESIGN_MCP_URL=
CODESIGN_MCP_TOOL=codesign-ask-hsd-agent
CODESIGN_MCP_TOKEN=

# ---- DCG Marketplace debug tools (optional MCP enrichment) ----
# Extra internal expert agents from the DCG / IT Central Marketplace. Each is
# independent and OFF unless its URL + token are set. When enabled, NEXUS folds
# their answers into the ticket context and cites them in the report's Reference
# Sources. Wiki KB runs whenever enabled; BIOS/S3M, kernel-crash and Redfish are
# consulted only when the ticket evidence is relevant (need-based).
# ⚠️ If you install the same tool as a VS Code Marketplace plugin, do NOT also set
#    it here — duplicate MCP configs for one tool can conflict.
# Internal wiki / knowledge base (architecture, specs, debug handbooks):
WIKI_MCP_URL=
WIKI_MCP_TOOL=VeWikiTool
WIKI_MCP_TOKEN=
# BIOS / firmware expert (DMR BIOS, S3M) — boot-hang / POST / S3M failures:
BIOS_MCP_URL=
BIOS_MCP_TOOL=
BIOS_MCP_TOKEN=
# Linux kernel crash analysis (panic / call-trace / driver decode):
KERNEL_MCP_URL=
KERNEL_MCP_TOOL=
KERNEL_MCP_TOKEN=
# Redfish / iDRAC out-of-band server management (BMC SEL, power state):
REDFISH_MCP_URL=
REDFISH_MCP_TOOL=
REDFISH_MCP_TOKEN=

# ---- Optional Axon CLI / Geni token (auto-fetch linked recordings) ----
# Option A: axon CLI — set path or ensure ~/bin/axon / PATH is set.
AXON_CLI_PATH=
# Option B: Geni AxonTool token — get from the acquire-tokens skill:
#   powershell -File "<plugin>/skills/acquire-tokens/scripts/get-tokens.ps1" axon
# Tokens expire in 30 min. When set, SVTools failure signatures are fetched
# automatically and surfaced in the root-cause section of every report.
AXON_GENI_TOKEN=

# ---- Server ----
HOST=127.0.0.1
PORT=8000

# ---- NUC PythonSV live-debug bridge ----
# When the SUT (Server Under Test) is hung/failed and unreachable, live-debug
# (execution mode 'nuc-pythonsv') connects to the NUC — a Windows box on the same
# bench that keeps PythonSV/ITP sideband access to the SUT.
# The tool tries SSH first, then falls back to WinRM. If neither is reachable it
# tells you the one-time WinRM setup to run on the NUC.
#   SSH  : requires OpenSSH Server on the NUC (usually already on).
#   WinRM: enable once on the NUC (elevated PowerShell):
#          winrm quickconfig -force ; Enable-PSRemoting -Force
# The NUC password is read ONLY from NUC_PASSWORD below and is never logged,
# returned to the UI, or written into any report/session file. Keep .env private.
NUC_HOST=
NUC_USER=
NUC_PASSWORD=
NUC_PYTHONSV_PATH=C:\pythonsv
# Transport preference: auto (SSH then WinRM) | ssh | winrm
NUC_TRANSPORT=auto
NUC_SSH_PORT=22
# WinRM transport (used on fallback; defaults shown). Use https + 5986 for TLS.
NUC_WINRM_TRANSPORT=ntlm
NUC_WINRM_SCHEME=http
NUC_WINRM_PORT=5985
