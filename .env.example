# ---- HSDES REST API ----
# Base URL of the Intel HSDES REST endpoint (adjust to your environment).
HSDES_BASE_URL=https://hsdes-api.intel.com/rest
# Personal API token / bearer token. Leave blank to run in OFFLINE mode.
HSDES_API_TOKEN=

# ---- LLM (OpenAI-compatible chat endpoint) ----
# e.g. an Azure OpenAI or Intel-internal OpenAI-compatible gateway.
# Leave blank to run in OFFLINE (deterministic, no-LLM) mode.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ---- Learned Knowledge Base ----
KB_DB_PATH=kb/hsd_kb.sqlite

# ---- Server ----
HOST=127.0.0.1
PORT=8000
