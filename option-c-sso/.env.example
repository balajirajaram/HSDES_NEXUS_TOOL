# ---- OIDC / SSO (Intel Azure AD or any OpenID Connect provider) ----
# Discovery must exist at <OIDC_ISSUER>/.well-known/openid-configuration
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://127.0.0.1:8100/auth/callback
# IMPORTANT: include the HSDES API scope so the access token is accepted by HSDES,
# e.g. "openid profile email api://<hsdes-app-id>/.default"
OIDC_SCOPES=openid profile email
# Random string used to sign session cookies (generate a long random value).
SESSION_SECRET=change-me-to-a-long-random-string

# ---- HSDES ----
HSDES_BASE_URL=https://hsdes-api.intel.com/rest

# ---- Internal MCP reader (HTTPS) — reads HSDs via an MCP server using the
# user's OAuth bearer token. When set, MCP is used first; HSDES REST is fallback.
# Geni validation MCP (HSDTool / HSDIndexTool) over the LaaS agent gateway:
MCP_SERVER_URL=
# e.g. https://laas-aks-prod01.laas.icloud.intel.com/agentgateway/api/a2a/geni/genivalidationmcpserver/
MCP_TOOL_NAME=HSDTool
MCP_PROTOCOL_VERSION=2025-06-18

# ---- LLM (OpenAI-compatible; a server-side service key is fine here) ----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ---- KB ----
KB_DB_PATH=kb/hsd_kb.sqlite

# ---- Server ----
HOST=127.0.0.1
PORT=8100
